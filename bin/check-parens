#!/usr/bin/env python3
"""Check paren balance in one or more files."""
import sys

def check_file(path):
    with open(path) as f:
        content = f.read()
    count = 0
    for i, ch in enumerate(content):
        if ch == '(': count += 1
        elif ch == ')': count -= 1
        if count < 0:
            line = content[:i].count('\n') + 1
            print(f'{path}:{line}: extra close paren (balance went negative)')
            return 1
    if count != 0:
        print(f'{path}: final balance {count} ({"unclosed" if count > 0 else "extra closes"})')
        return 1
    return 0

status = 0
for path in sys.argv[1:]:
    status |= check_file(path)
sys.exit(status)
